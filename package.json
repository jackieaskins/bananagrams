{
  "name": "bananagrams",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently --kill-others --handle-input \"pnpm -r watch\" \"spacetime start\" \"spacetime dev\"",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "catalog:"
  },
  "lint-staged": {
    "!(eslint-config/**/*)*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "(eslint-config/**/*)*.{js,ts}": [
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  }
}
